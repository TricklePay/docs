{
  "version": "0.2",
  "language": "en",
  "dictionaries": ["project-words"],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": ".cspell/project-words.txt",
      "addWords": true
    }
  ],
  "ignorePaths": [
    ".git/**",
    "node_modules/**",
    ".github/**",
    "scripts/**"
  ],
  "files": ["**/*.md"],
  "overrides": [
    {
      "filename": "**/*.md",
      "ignoreRegExpList": [
        "`[^`]+`",
        "```[\\s\\S]*?```"
      ]
    }
  ]
}
